# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-here
DATABASE_URL=mysql://root:password@localhost:3306/clawd
OWNER_OPEN_ID=

# ── LLM Provider (choose one) ────────────────────────────────────────────────
# Option 1: Google Gemini (free tier, recommended for getting started)
GEMINI_API_KEY=your-gemini-api-key

# Option 2: Forge/Manus (OpenAI-compatible endpoint)
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=your-forge-key

# ── OAuth (optional) ─────────────────────────────────────────────────────────
OAUTH_SERVER_URL=

# ── Mobile App (set in Expo env) ─────────────────────────────────────────────
# EXPO_PUBLIC_MIST_GATEWAY_HOST=localhost          # Python gateway host (local dev)
# EXPO_PUBLIC_MIST_API_BASE_URL=                    # tRPC server URL (cloud deploy)
