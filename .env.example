# ─── App ────────────────────────────────────────────────────────────────────────
VITE_APP_ID=
JWT_SECRET=mist-secret-2026
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
NODE_ENV=production

# ─── LLM Providers (cascade: Gemini → Groq → Together AI → OpenRouter → Forge) ─
# At least one key required. MIST auto-cascades on quota exhaustion.

# Google Gemini (primary) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_API_KEY_2=           # Optional: 2nd key from different Google project for rotation

# Groq (Llama 3.3 70B) — https://console.groq.com
GROQ_API_KEY=

# Together AI (Llama 3.3 70B Turbo Free) — https://api.together.xyz
TOGETHER_API_KEY=

# OpenRouter (Llama 3.3 70B Free) — https://openrouter.ai
OPENROUTER_API_KEY=

# Moonshot / Kimi (legacy) — https://moonshot.cn
MOONSHOT_API_KEY=

# Forge / Manus (legacy fallback)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Mobile App ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_MIST_API_BASE_URL=   # e.g., https://clawd-api-production.up.railway.app
EXPO_PUBLIC_MIST_GATEWAY_HOST=   # Local gateway host (default: localhost)
