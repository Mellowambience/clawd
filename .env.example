# ── Required ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional model fallbacks ──────────────────────
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# ── Optional Supabase cloud sync ──────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_ENABLED=false

# ── Storage ──────────────────────────────────
SQLITE_PATH=/app/data/mist.db
REDIS_URL=redis://redis:6379/0

# ── API ────────────────────────────────────────
API_PORT=7777
API_BASE_URL=http://localhost:7777/api/v1

# ── Identity ───────────────────────────────────
MOTHERSHIP_HANDLE=AMARA
ETH_WALLET=0x212d3a3D4a78EA78c54d54f37a9bE9e5e020Bf75
MOTHERSHIP_VERSION=0.1.0
TZ=America/New_York

# ── Location (Philadelphia default) ─────────────────
DEFAULT_LAT=39.9526
DEFAULT_LON=-75.1652

# ── Features ───────────────────────────────────
VOIDCHAT_ENABLED=true
VOICE_INPUT_ENABLED=false
AFK_MODE=false
